<%# app/views/arrivals/_arrivals.html.erb %>
<% if grouped.empty? %>
  <p class="text-gray-600">No live arrivals right now.</p>
<% else %>
  <% grouped.each do |line_name, by_direction| %>
    <section class="mb-16">
      <h2 class="text-lg font-semibold mb-2"><%= line_name %> line</h2>

      <table class="w-full text-left border-collapse">
        <thead>
        <tr class="border-b border-gray-300">
          <th class="py-4 pr-4 font-medium">Direction</th>
          <th class="py-4 pr-4 font-medium">Destination</th>
          <th class="py-4 pr-4 font-medium">Platform</th>
          <th class="py-4 pr-4 font-medium">Expected</th>
          <th class="py-4 font-medium">Due in</th>
        </tr>
        </thead>
        <tbody>
        <% %w[inbound outbound unknown].each do |dir| %>
          <% (by_direction[dir] || []).each do |a| %>
            <tr class="border-b border-gray-200">
              <td class="py-4 pr-4"><%= dir.titleize %></td>
              <td class="py-4 pr-4"><%= a.destination %></td>
              <td class="py-4 pr-4"><%= a.platform_label %></td>
              <td class="py-4 pr-4"><%= a.expected_arrival&.in_time_zone("London")&.strftime("%H:%M") %></td>
              <td class="py-4"><%= a.display_time %></td>
            </tr>
          <% end %>
        <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
<% end %>